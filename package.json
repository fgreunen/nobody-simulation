{
  "name": "nobody-stellar-observatory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs lint",
    "lint:raw": "oxlint --deny-warnings src tests scripts *.ts",
    "typecheck": "node scripts/check.mjs typecheck",
    "typecheck:raw": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check.mjs build",
    "build:raw": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:test": "vite build --mode test --outDir .test-dist",
    "preview:test": "vite preview --host 127.0.0.1 --outDir .test-dist --port 5190 --strictPort",
    "test": "node scripts/check.mjs test",
    "test:raw": "vitest run",
    "test:browser": "node scripts/check.mjs test:browser",
    "test:browser:raw": "playwright test",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "^0.183.0",
    "oxlint": "^1.91.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
